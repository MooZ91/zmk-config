#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/*
 * Plataforma de destino
 * ---------------------
 * Solo se compila una de las dos listas de macros. Cambiá el valor por defecto
 * acá abajo, o pasalo desde build.yaml sin tocar este archivo:
 *
 *     cmake-args: -DDTS_EXTRA_CPPFLAGS=-DMB9I_OS_MACOS
 *
 * Las dos listas definen los mismos nombres, así que las capas no cambian
 * según la plataforma.
 */
#if !defined(MB9I_OS_WIN) && !defined(MB9I_OS_MACOS)
#define MB9I_OS_WIN
#endif

#if defined(MB9I_OS_WIN) && defined(MB9I_OS_MACOS)
#error "Definí una sola plataforma: MB9I_OS_WIN o MB9I_OS_MACOS"
#endif

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp C_VOL_DN &kp C_VOL_UP &mo 1
                &macro_paste &macro_zoom_in &macro_zoom_out
                &macro_modbox &macro_undo &macro_redo
            >;
        };

        bt_layer {
            bindings = <
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1
                &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                &trans &studio_unlock &bootloader
            >;
        };

        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };

        extra3 {
            status = "reserved";
        };
    };

    macros {

        /* --- Comunes a ambas plataformas --- */

        macro_modbox: macro_modbox {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp M &kp O &kp D &kp B &kp O &kp X &kp ENTER>;
        };

        macro_outdent: macro_outdent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LS(TAB)>;
        };

        // Toggle Integrated Terminal (mismo atajo en las dos plataformas)
        macro_toggle_terminal: macro_toggle_terminal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(GRAVE)>;
        };

        // Format Document (mismo atajo en las dos plataformas)
        macro_format_document: macro_format_document {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LS(LA(F))>;
        };

        // Go to Definition (misma tecla en las dos plataformas)
        macro_go_to_definition: macro_go_to_definition {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp F12>;
        };

        // Rename Symbol (misma tecla en las dos plataformas)
        macro_rename_symbol: macro_rename_symbol {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp F2>;
        };

#ifdef MB9I_OS_WIN

        /* --- Edición (Windows) --- */

        macro_copy: macro_copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(C)>;
        };

        macro_paste: macro_paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(V)>;
        };

        macro_cut: macro_cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(X)>;
        };

        macro_select_all: macro_select_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(A)>;
        };

        macro_undo: macro_undo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(Z)>;
        };

        macro_redo: macro_redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(Y)>;
        };

        macro_duplicate: macro_duplicate {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(D)>;
        };

        macro_comment: macro_comment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(FSLH)>;
        };

        /* --- Archivos (Windows) --- */

        macro_save: macro_save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(S)>;
        };

        macro_save_as: macro_save_as {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(LS(S))>;
        };

        macro_new: macro_new {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(N)>;
        };

        macro_open: macro_open {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(O)>;
        };

        macro_print: macro_print {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(P)>;
        };

        /* --- Búsqueda (Windows) --- */

        macro_find: macro_find {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(F)>;
        };

        macro_find_next: macro_find_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(G)>;
        };

        macro_replace: macro_replace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(H)>;
        };

        /* --- Formato de texto (Windows) --- */

        macro_bold: macro_bold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(B)>;
        };

        macro_italic: macro_italic {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(I)>;
        };

        macro_underline: macro_underline {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(U)>;
        };

        /* --- Pestañas y zoom (Windows) --- */

        macro_new_tab: macro_new_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(T)>;
        };

        macro_close_tab: macro_close_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(W)>;
        };

        macro_reopen_tab: macro_reopen_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(LS(T))>;
        };

        macro_refresh: macro_refresh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(R)>;
        };

        macro_zoom_in: macro_zoom_in {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(KP_PLUS)>;
        };

        macro_zoom_out: macro_zoom_out {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(KP_MINUS)>;
        };

        macro_zoom_reset: macro_zoom_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(N0)>;
        };

        /* --- Sistema (Windows) --- */

        // Alt+F4
        macro_quit_app: macro_quit_app {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LA(F4)>;
        };

        // Alt+Tab
        macro_switch_app: macro_switch_app {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LA(TAB)>;
        };

        // Win+S: búsqueda del sistema, equivalente a Spotlight
        macro_search: macro_search {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(S)>;
        };

        // Win+Shift+S: recorte de pantalla
        macro_screenshot: macro_screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(LS(S))>;
        };

        // Win+L
        macro_lock_screen: macro_lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(L)>;
        };

        // Win+Flecha abajo
        macro_minimize_window: macro_minimize_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(DOWN)>;
        };

        // Win+D: mostrar escritorio, equivalente a ocultar la app
        macro_hide_app: macro_hide_app {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(D)>;
        };

        macro_new_window: macro_new_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(N)>;
        };

        // Ctrl+Shift+Esc: administrador de tareas
        macro_force_quit: macro_force_quit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(LS(ESC))>;
        };

        /* --- VS Code (Windows) --- */

        macro_command_palette: macro_command_palette {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(LS(P))>;
        };

        macro_quick_open: macro_quick_open {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(P)>;
        };

        macro_toggle_sidebar: macro_toggle_sidebar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(B)>;
        };

        macro_quick_fix: macro_quick_fix {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(DOT)>;
        };

        macro_split_editor: macro_split_editor {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(BSLH)>;
        };

        macro_multi_cursor_down: macro_multi_cursor_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(LA(DOWN))>;
        };

        // Zen Mode: acorde Ctrl+K, luego Z
        macro_zen_mode: macro_zen_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LC(K) &kp Z>;
        };

#else /* MB9I_OS_MACOS */

        /* --- Edición (macOS) --- */

        macro_copy: macro_copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(C)>;
        };

        macro_paste: macro_paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(V)>;
        };

        macro_cut: macro_cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(X)>;
        };

        macro_select_all: macro_select_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(A)>;
        };

        macro_undo: macro_undo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(Z)>;
        };

        // En macOS rehacer es Cmd+Shift+Z, no una tecla aparte
        macro_redo: macro_redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(LS(Z))>;
        };

        macro_duplicate: macro_duplicate {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(D)>;
        };

        macro_comment: macro_comment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(FSLH)>;
        };

        /* --- Archivos (macOS) --- */

        macro_save: macro_save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(S)>;
        };

        macro_save_as: macro_save_as {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(LS(S))>;
        };

        macro_new: macro_new {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(N)>;
        };

        macro_open: macro_open {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(O)>;
        };

        macro_print: macro_print {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(P)>;
        };

        /* --- Búsqueda (macOS) --- */

        macro_find: macro_find {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(F)>;
        };

        macro_find_next: macro_find_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(G)>;
        };

        // Cmd+Opt+F: buscar y reemplazar
        macro_replace: macro_replace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(LA(F))>;
        };

        /* --- Formato de texto (macOS) --- */

        macro_bold: macro_bold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(B)>;
        };

        macro_italic: macro_italic {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(I)>;
        };

        macro_underline: macro_underline {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(U)>;
        };

        /* --- Pestañas y zoom (macOS) --- */

        macro_new_tab: macro_new_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(T)>;
        };

        macro_close_tab: macro_close_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(W)>;
        };

        macro_reopen_tab: macro_reopen_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(LS(T))>;
        };

        macro_refresh: macro_refresh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(R)>;
        };

        macro_zoom_in: macro_zoom_in {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(KP_PLUS)>;
        };

        macro_zoom_out: macro_zoom_out {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(KP_MINUS)>;
        };

        macro_zoom_reset: macro_zoom_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(N0)>;
        };

        /* --- Sistema (macOS) --- */

        macro_quit_app: macro_quit_app {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(Q)>;
        };

        macro_switch_app: macro_switch_app {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(TAB)>;
        };

        // Cmd+Espacio: Spotlight
        macro_search: macro_search {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(SPACE)>;
        };

        // Cmd+Shift+4: captura de una selección
        macro_screenshot: macro_screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(LS(N4))>;
        };

        macro_lock_screen: macro_lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(LC(Q))>;
