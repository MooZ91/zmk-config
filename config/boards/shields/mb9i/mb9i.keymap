        macro_force_quit: macro_force_quit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(LA(ESC))>;
        };

        /* --- VS Code (macOS) --- */

        macro_command_palette: macro_command_palette {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
